# ── Orbital Guardian — Backend Environment Config ────────────────────────────
#
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git — it is already in .gitignore
#
# Space-Track.org (free account at https://www.space-track.org/auth/createAccount)
SPACETRACK_USER=your_email@example.com
SPACETRACK_PASS=your_password

# CelesTrak (no account needed — but User-Agent is required)
CELESTRAK_USER_AGENT=OrbitalGuardian/1.0 (educational project)

# How many debris objects to screen per conjunction scan (higher = slower)
MAX_DEBRIS_OBJECTS=200

# Local PostgreSQL for native backend development. Docker Compose overrides
# the hostname to "db" inside the backend and migration containers.
DATABASE_URL=postgresql+psycopg://orbital:orbital_local_dev@localhost:5432/orbital_guardian

# Temporary migration route for moving the old browser Zustand state.
# Set false after the browser has successfully imported its local data.
ALLOW_LOCAL_STATE_IMPORT=true
